* { box-sizing: border-box; }
html { min-width: 320px; background: var(--cream); }
body { margin: 0; color: var(--ink); background: var(--cream); font-size: 14px; }
button, input, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button { cursor: pointer; }
a { color: inherit; text-decoration: none; }
svg { width: 20px; height: 20px; }
h1, h2, h3, p { margin: 0; }
#app-content:focus { outline: none; }
.app-shell { min-height: 100vh; display: grid; grid-template-columns: 254px minmax(0, 1fr); }
.sidebar { position: sticky; top: 0; height: 100vh; padding: 26px 18px 18px; display: flex; flex-direction: column; background: var(--forest-950); color: #eaf0ed; z-index: 20; }
.brand { display: flex; align-items: center; gap: 12px; padding: 0 8px; }
.brand-mark { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; color: white; background: var(--forest-600); font-family: Georgia, serif; font-size: 25px; font-weight: 700; }
.brand > span:last-child, .profile > span:nth-child(2), .book-switcher > span:nth-child(2) { display: grid; gap: 3px; }
.brand strong { font-family: Georgia, serif; font-size: 21px; letter-spacing: .2px; }
.brand small, .profile small, .book-switcher small { color: #91a19a; font-size: 11px; }
.book-switcher { margin-top: 32px; padding: 12px; display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 10px; border: 1px solid #34443e; border-radius: 12px; background: #21312b; }
.book-icon { width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; color: #bee0d1; background: #2d5848; font-size: 11px; font-weight: 800; }
.book-switcher strong { font-size: 13px; }
.chevron { color: #7f9189; }
.primary-nav { margin-top: 26px; display: grid; gap: 5px; }
.primary-nav a, .sidebar-footer > a { min-height: 44px; padding: 0 12px; display: flex; align-items: center; gap: 12px; border-radius: 10px; color: #aebbb5; font-weight: 600; transition: .18s ease; }
.primary-nav a:hover, .sidebar-footer > a:hover, .primary-nav a.active, .sidebar-footer > a.active { color: white; background: #293c35; }
.primary-nav a.active { box-shadow: inset 3px 0 var(--forest-600); }
.primary-nav svg, .sidebar-footer svg { width: 19px; }
.sidebar-footer { margin-top: auto; display: grid; gap: 12px; }
.profile { padding: 14px 8px 2px; display: grid; grid-template-columns: 38px 1fr auto; align-items: center; gap: 10px; border-top: 1px solid #304039; }
.avatar { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: #d6bfa2; color: #4d3b2a; font-size: 11px; font-weight: 800; }
.profile strong { font-size: 12px; }
.workspace { min-width: 0; padding: 0 32px 42px; }
.topbar { min-height: 104px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
.eyebrow { margin-bottom: 5px; color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
.topbar h1 { font-family: Georgia, serif; font-size: clamp(24px, 3vw, 31px); font-weight: 600; }
.top-actions { display: flex; gap: 10px; }
.icon-button, .primary-button, .secondary-button, .danger-button { border: 0; border-radius: 10px; min-height: 42px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700; }
.icon-button { width: 42px; color: var(--ink); border: 1px solid var(--line); background: var(--paper); }
.icon-button.subtle { border: 0; background: #f2f4f2; }
.primary-button { padding: 0 17px; color: white; background: var(--forest-700); box-shadow: 0 7px 18px rgba(29, 107, 81, .18); }
.primary-button:hover { background: #165c45; }
.secondary-button { padding: 0 15px; color: var(--ink); border: 1px solid var(--line); background: white; }
.danger-button { padding: 0 15px; color: #a23f38; background: var(--red-soft); }
.mobile-menu, .mobile-fab { display: none; }
.hero-card { min-height: 206px; padding: 34px 38px; position: relative; overflow: hidden; display: flex; align-items: center; color: white; background: linear-gradient(120deg, #18382e 0%, #225f4b 100%); border-radius: var(--radius-lg); box-shadow: 0 18px 50px rgba(23, 53, 44, .16); }
.hero-card::before { content: ""; position: absolute; width: 500px; height: 500px; right: -190px; top: -230px; border: 1px solid rgba(255,255,255,.09); border-radius: 50%; box-shadow: 0 0 0 45px rgba(255,255,255,.025), 0 0 0 95px rgba(255,255,255,.018); }
.hero-copy { position: relative; z-index: 2; display: grid; justify-items: start; }
.hero-label { color: #b8d1c7; font-size: 13px; }
.hero-copy > strong { margin: 11px 0 16px; font-family: Georgia, serif; font-size: clamp(34px, 5vw, 48px); font-weight: 500; letter-spacing: -.03em; }
.positive-chip { padding: 7px 10px; display: inline-flex; align-items: center; gap: 6px; color: #bce5d5; background: rgba(202, 238, 223, .1); border-radius: 999px; font-size: 11px; font-weight: 700; }
.positive-chip svg { width: 15px; height: 15px; }
.hero-orbit { position: absolute; width: 142px; height: 142px; right: 92px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.14); border-radius: 50%; }
.hero-orbit::before, .hero-orbit::after { content: ""; position: absolute; inset: 18px; border: 1px solid rgba(255,255,255,.1); border-radius: inherit; }
.hero-orbit::after { inset: 36px; background: rgba(255,255,255,.04); }
.hero-orbit b { position: relative; z-index: 2; font-family: Georgia, serif; font-size: 40px; font-weight: 500; }
.hero-orbit span { position: absolute; width: 7px; height: 7px; background: #d1ab68; border-radius: 50%; }
.hero-orbit span:first-child { top: 11px; right: 30px; }.hero-orbit span:nth-child(2) { bottom: 17px; left: 21px; background: #74b697; }
.metric-grid { margin: 16px 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.metric-card, .panel { border: 1px solid var(--line); background: var(--paper); border-radius: var(--radius-md); box-shadow: var(--shadow); }
.metric-card { min-height: 116px; padding: 20px; display: flex; align-items: center; gap: 15px; }
.metric-icon { width: 43px; height: 43px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 13px; font-size: 20px; font-weight: 800; }.metric-icon.income { color: var(--green); background: var(--green-soft); }.metric-icon.expense { color: var(--red); background: var(--red-soft); }.metric-icon.net { color: var(--blue); background: #e8eef7; }
.metric-card > div { min-width: 0; display: grid; gap: 4px; }.metric-card small { color: var(--muted); }.metric-card strong { font-family: Georgia, serif; font-size: 22px; }.metric-card em { color: #86918c; font-size: 10px; font-style: normal; }
.dashboard-grid { margin-bottom: 16px; display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(300px, .75fr); gap: 16px; }
.panel { padding: 22px; }
.panel-head { margin-bottom: 18px; display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
.panel-head h2 { font-family: Georgia, serif; font-size: 19px; font-weight: 600; }.panel-head p { margin-top: 5px; color: var(--muted); font-size: 11px; }.panel-head a { display: inline-flex; align-items: center; gap: 5px; color: var(--forest-700); font-size: 11px; font-weight: 700; white-space: nowrap; }.panel-head a svg { width: 14px; }
select, input { min-height: 42px; padding: 0 12px; color: var(--ink); border: 1px solid var(--line); border-radius: 9px; background: #fff; outline: none; }select:focus, input:focus { border-color: var(--forest-600); box-shadow: 0 0 0 3px rgba(39, 128, 98, .1); }
.panel-head select { min-height: 34px; color: var(--muted); font-size: 11px; }
.legend { display: flex; justify-content: flex-end; gap: 14px; color: var(--muted); font-size: 10px; }.legend span { display: flex; align-items: center; gap: 5px; }.legend i { width: 8px; height: 8px; border-radius: 3px; }.legend-income { background: var(--forest-700); }.legend-expense { background: #d6a448; }
.cashflow-chart { height: 205px; margin-top: 7px; display: grid; grid-template-columns: 35px 1fr; border-bottom: 1px solid var(--line); background: repeating-linear-gradient(to bottom, transparent 0, transparent 49px, #edf0ed 50px); }
.chart-axis { padding-bottom: 2px; display: flex; flex-direction: column; justify-content: space-between; color: #a0aaa5; font-size: 9px; }.chart-bars { display: flex; justify-content: space-around; gap: 7px; }.bar-group { flex: 1; min-width: 22px; display: grid; grid-template-rows: 1fr 20px; align-items: end; }.bar-pair { height: 100%; display: flex; align-items: end; justify-content: center; gap: 4px; }.bar-pair i { width: min(14px, 36%); min-height: 3px; border-radius: 4px 4px 0 0; }.income-bar { background: var(--forest-700); }.expense-bar { background: #d6a448; }.bar-group > span { padding-top: 6px; text-align: center; color: var(--muted); font-size: 9px; }
.upcoming-list { display: grid; }.upcoming-row { padding: 12px 0; display: grid; grid-template-columns: 40px 1fr auto; align-items: center; gap: 10px; border-bottom: 1px solid var(--line); }.upcoming-row time { width: 36px; height: 42px; display: grid; place-items: center; align-content: center; border-radius: 9px; color: var(--forest-700); background: var(--green-soft); }.upcoming-row time b { font-size: 14px; line-height: 15px; }.upcoming-row time span { font-size: 8px; text-transform: uppercase; }.upcoming-row > div { display: grid; gap: 3px; }.upcoming-row strong { font-size: 11px; }.upcoming-row small { color: var(--muted); font-size: 9px; }.upcoming-row > b { font-size: 11px; }.income { color: var(--green) !important; }.expense { color: var(--red) !important; }.upcoming-total { padding-top: 15px; display: flex; justify-content: space-between; color: var(--muted); font-size: 10px; }.upcoming-total strong { color: var(--ink); font-size: 12px; }
.recent-panel { overflow-x: auto; }.transaction-table { min-width: 700px; }.table-head, .table-row { display: grid; grid-template-columns: 1.55fr 1fr 1fr 1fr .8fr; align-items: center; gap: 14px; }.table-head { padding: 0 13px 9px; color: #9aa49f; font-size: 9px; font-weight: 700; text-transform: uppercase; }.table-row { min-height: 56px; padding: 9px 13px; border-top: 1px solid var(--line); color: #65716b; font-size: 10px; }.table-row > strong:last-child { text-align: right; font-size: 11px; }.transaction-name { display: flex; align-items: center; gap: 10px; color: var(--ink); }.transaction-name i { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 9px; color: var(--dot); background: color-mix(in srgb, var(--dot) 13%, white); font-style: normal; font-weight: 800; }.category-dot { width: 7px; height: 7px; margin-right: 6px; display: inline-block; border-radius: 50%; background: var(--dot); }
.page-section { display: grid; gap: 16px; }
.filter-bar { display: flex; gap: 10px; }
.search-field { min-width: 260px; flex: 1; display: flex; align-items: center; gap: 7px; padding-left: 13px; border: 1px solid var(--line); border-radius: 10px; background: white; }
.search-field input { width: 100%; border: 0; box-shadow: none; }
.expanded .table-row { min-height: 62px; }
.section-intro { padding: 25px 28px; display: flex; align-items: center; justify-content: space-between; color: white; background: var(--forest-900); border-radius: var(--radius-md); }
.section-intro h2 { margin: 6px 0 2px; font-family: Georgia, serif; font-size: 30px; }.section-intro span { color: #a8b9b1; font-size: 11px; }.section-intro .eyebrow { color: #96afa4; }
.account-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
.account-card { min-height: 215px; padding: 22px; position: relative; overflow: hidden; display: grid; align-content: space-between; border: 1px solid var(--line); border-radius: var(--radius-md); background: white; box-shadow: var(--shadow); }
.account-card::after { content: ""; position: absolute; width: 150px; height: 150px; right: -55px; bottom: -70px; border: 25px solid color-mix(in srgb, var(--account) 9%, transparent); border-radius: 50%; }
.account-top { display: flex; justify-content: space-between; }.account-top button { border: 0; background: transparent; color: var(--muted); }
.account-symbol { width: 40px; height: 40px; display: grid; place-items: center; color: var(--account); background: color-mix(in srgb, var(--account) 12%, white); border-radius: 12px; font-size: 18px; }
.account-card small { color: var(--muted); }.account-card h3 { margin-top: 4px; font-family: Georgia, serif; font-size: 19px; }.account-card > strong { font-family: Georgia, serif; font-size: 26px; }
.account-line { position: absolute; height: 3px; inset: auto 0 0; background: color-mix(in srgb, var(--account) 20%, white); }.account-line span { display: block; width: 70%; height: 100%; background: var(--account); }
.schedule-panel { min-height: 440px; }.schedule-list { display: grid; }
.schedule-row { min-height: 82px; display: grid; grid-template-columns: 25px 130px 1fr auto 120px; align-items: center; gap: 12px; border-top: 1px solid var(--line); }
.timeline-dot { height: 100%; position: relative; display: grid; place-items: center; }.timeline-dot i { width: 10px; height: 10px; z-index: 1; border: 3px solid var(--green-soft); border-radius: 50%; background: var(--forest-700); }.timeline-dot b { position: absolute; width: 1px; top: 50%; bottom: -50%; background: var(--line); }
.schedule-row time { color: var(--muted); font-size: 11px; }.schedule-row > div { display: grid; gap: 4px; }.schedule-row small { color: var(--muted); }.schedule-row > b { text-align: right; }
.status-pill { padding: 5px 9px; color: var(--amber); background: var(--amber-soft); border-radius: 999px; font-size: 9px; font-weight: 700; }
.report-grid { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(260px, .65fr); gap: 16px; }
.donut-layout { min-height: 310px; display: grid; grid-template-columns: minmax(200px, .8fr) 1fr; align-items: center; gap: 25px; }
.donut { width: 205px; aspect-ratio: 1; margin: auto; position: relative; display: grid; place-items: center; border-radius: 50%; background: conic-gradient(var(--segments)); }.donut::after { content: ""; position: absolute; inset: 34px; border-radius: 50%; background: white; }.donut span { z-index: 1; display: grid; text-align: center; }.donut small { color: var(--muted); font-size: 10px; }.donut strong { margin-top: 5px; font-family: Georgia, serif; font-size: 20px; }
.report-legend { display: grid; }.report-legend > div { min-height: 48px; display: grid; grid-template-columns: 10px 1fr 40px 95px; align-items: center; gap: 8px; border-bottom: 1px solid var(--line); font-size: 10px; }.report-legend i { width: 8px; height: 8px; border-radius: 50%; background: var(--dot); }.report-legend b { color: var(--muted); }.report-legend strong { text-align: right; }
.savings-card { min-height: 390px; display: grid; justify-items: center; align-content: center; text-align: center; background: linear-gradient(150deg, #fff, #edf4f0); }.savings-card > span { color: var(--muted); }.savings-card > strong { margin: 7px 0 20px; font-family: Georgia, serif; font-size: 32px; }
.score-ring { width: 145px; aspect-ratio: 1; display: grid; place-content: center; border-radius: 50%; background: radial-gradient(closest-side, #f5f8f6 78%, transparent 79% 100%), conic-gradient(var(--forest-700) 67%, #dce7e1 0); }.score-ring b { font-size: 30px; }.score-ring small { color: var(--muted); }.savings-card p { max-width: 210px; margin-top: 20px; color: var(--muted); font-size: 11px; line-height: 1.6; }
.settings-grid { grid-template-columns: repeat(2, 1fr); }.settings-card { display: grid; align-content: start; gap: 4px; }.settings-card h2 { margin-bottom: 14px; font-family: Georgia, serif; }.settings-card p { margin-bottom: 20px; color: var(--muted); line-height: 1.65; }
.settings-row { min-height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 15px; border-top: 1px solid var(--line); }.settings-row span { color: var(--muted); }.settings-row code { max-width: 55%; overflow: hidden; text-overflow: ellipsis; }.warning { color: var(--amber); }
.entry-dialog { width: min(560px, calc(100vw - 28px)); padding: 0; color: var(--ink); border: 0; border-radius: 20px; box-shadow: 0 24px 80px rgba(10, 25, 18, .25); }
.entry-dialog::backdrop { background: rgba(11, 23, 18, .56); backdrop-filter: blur(3px); }.entry-dialog form { padding: 25px; }
.dialog-head { display: flex; justify-content: space-between; align-items: flex-start; }.dialog-head h2 { font-family: Georgia, serif; font-size: 25px; }
.type-tabs { margin: 22px 0; padding: 4px; display: grid; grid-template-columns: repeat(3, 1fr); border-radius: 11px; background: #f0f3f1; }.type-tabs input { position: absolute; opacity: 0; pointer-events: none; }.type-tabs span { min-height: 36px; display: grid; place-items: center; border-radius: 8px; color: var(--muted); font-weight: 700; cursor: pointer; }.type-tabs input:checked + span { color: var(--forest-700); background: white; box-shadow: 0 3px 10px rgba(20,40,30,.08); }
.amount-field { display: grid; gap: 7px; }.amount-field > span, .form-grid label > span { color: var(--muted); font-size: 11px; font-weight: 700; }.amount-field > div { position: relative; }.amount-field input { width: 100%; height: 61px; padding-right: 45px; font-family: Georgia, serif; font-size: 30px; }.amount-field b { position: absolute; right: 17px; top: 17px; color: var(--muted); font-size: 23px; }
.form-grid { margin-top: 15px; display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }.form-grid label { display: grid; gap: 7px; }.dialog-actions { margin-top: 22px; display: flex; justify-content: flex-end; gap: 9px; }
.toast { position: fixed; left: 50%; bottom: 24px; z-index: 50; padding: 12px 17px; color: white; background: var(--forest-950); border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.18); transform: translate(-50%, 130%); opacity: 0; transition: .25s ease; }.toast.visible { transform: translate(-50%, 0); opacity: 1; }
.spinning svg { animation: spin .8s linear infinite; }@keyframes spin { to { transform: rotate(360deg); } }
@media (max-width: 1050px) {
  .app-shell { grid-template-columns: 220px minmax(0, 1fr); }.workspace { padding-inline: 22px; }.hero-orbit { right: 40px; }
  .dashboard-grid, .report-grid { grid-template-columns: 1fr; }.upcoming-card { min-height: auto; }.metric-card { padding: 16px; }.metric-card strong { font-size: 18px; }
}
@media (max-width: 760px) {
  .app-shell { display: block; }.sidebar { position: fixed; left: 0; width: min(300px, 88vw); transform: translateX(-105%); transition: transform .24s ease; box-shadow: 10px 0 40px rgba(0,0,0,.2); }.sidebar.open { transform: translateX(0); }
  .workspace { padding: 0 15px 90px; }.topbar { min-height: 88px; }.mobile-menu { width: 40px; height: 40px; flex: 0 0 auto; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 10px; background: white; }.top-actions .primary-button { display: none; }
  .hero-card { min-height: 180px; padding: 26px; }.hero-orbit { right: -28px; opacity: .55; }.metric-grid { grid-template-columns: 1fr; }.metric-card { min-height: 92px; }.account-grid, .settings-grid { grid-template-columns: 1fr; }
  .filter-bar { flex-wrap: wrap; }.search-field { min-width: 100%; }.mobile-fab { width: 58px; height: 58px; position: fixed; right: 20px; bottom: 20px; z-index: 15; display: grid; place-items: center; color: white; border: 0; border-radius: 50%; background: var(--forest-700); box-shadow: 0 12px 30px rgba(29, 107, 81, .3); }
  .donut-layout { grid-template-columns: 1fr; }.schedule-row { grid-template-columns: 25px 1fr auto; padding: 12px 0; }.schedule-row time, .schedule-row .status-pill { display: none; }.form-grid { grid-template-columns: 1fr; }
}
@media (max-width: 440px) {
  .workspace { padding-inline: 11px; }.topbar h1 { font-size: 22px; }.hero-copy > strong { font-size: 31px; }.hero-orbit { display: none; }.panel, .entry-dialog form { padding: 17px; }
  .section-intro { align-items: flex-start; flex-direction: column; gap: 16px; }.report-legend > div { grid-template-columns: 10px 1fr 30px 80px; }
}
