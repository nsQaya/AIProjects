{
  "name": "@defterx/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && wrangler deploy --dry-run --outdir .wrangler-dist",
    "check": "node scripts/check.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "dev": "node scripts/build.mjs && wrangler dev --config wrangler.jsonc --ip 127.0.0.1 --port 3000",
    "deploy": "node scripts/build.mjs && wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.30.0"
  }
}
